{
  "name": "tabula-md",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "tabula-app",
    "packages/tabula"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:local": "VITE_TABULA_FIREBASE_EMULATOR_HOST=127.0.0.1 vite --host 0.0.0.0",
    "dev:firebase": "npx --yes firebase-tools@15.22.4 emulators:start --project tabula-local --config scripts/browser-smoke/fixtures/firebase/firebase.json",
    "build": "tsc && vite build",
    "check:build-info": "node scripts/check-build-info.mjs",
    "test:production-deploy": "node --test scripts/production-deployment.test.mjs",
    "verify:production": "node scripts/verify-production-deployment.mjs",
    "build:core": "npm run build -w @tabula-md/tabula",
    "check:core-runtime": "npm run build:core && node scripts/check-core-runtime.mjs",
    "check:core-package": "npm run build:core && node scripts/check-tabula-package.mjs",
    "perf:preview-architecture": "npm run build:core && node scripts/preview-architecture-benchmark.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "surface:check": "node scripts/public-surface-check.mjs",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:playwright": "playwright test",
    "test:browser:playwright:canary": "playwright test harness.spec.ts markdown-parity.spec.mjs visual-interaction.spec.mjs right-panels.spec.mjs",
    "test:browser:workspace": "npm run test:browser:playwright -- storage-restore.spec.mjs workspace-boundaries.spec.mjs",
    "test:browser:editor": "npm run test:browser:visual && npm run test:browser:preview && npm run test:browser -- --suite=editor-preview-sync,editor-preview-typography,editor-search-layout,editor-search-source,editor-search-replace,editor-search-preview,editor-search-focus-history,editor-selection-comments,split-layout",
    "test:browser:preview": "npm run test:browser:playwright -- markdown-parity.spec.mjs preview-navigation.spec.mjs editor-controls.spec.mjs responsive-layout.spec.mjs",
    "test:browser:visual": "npm run test:browser:playwright -- markdown-parity.spec.mjs visual-interaction.spec.mjs editor-controls.spec.mjs responsive-layout.spec.mjs",
    "test:browser:editor-certification": "npm run test:browser -- --suite=editor-certification",
    "test:browser:layout": "npm run test:browser -- --suite=layout",
    "test:browser:panels": "npm run test:browser:playwright -- right-panels.spec.mjs",
    "test:browser:knowledge": "npm run test:browser -- --suite=knowledge-links,okf-concepts",
    "test:browser:collab": "npm run test:browser:playwright -- collaboration-capability.spec.mjs",
    "test:browser:collaboration-editor-torture": "npm run test:browser -- --suite=collaboration-editor-torture",
    "test:browser:collaboration-memory": "npm run test:browser -- --suite=collaboration-memory",
    "test:browser:json-share": "npm run test:browser:playwright -- share-capability.spec.mjs",
    "test:browser:regression": "node --test scripts/browser-smoke/final-regression-matrix.test.mjs && npm run test:browser:playwright -- harness.spec.ts markdown-parity.spec.mjs visual-interaction.spec.mjs editor-controls.spec.mjs responsive-layout.spec.mjs preview-navigation.spec.mjs right-panels.spec.mjs accessibility-regression.spec.mjs storage-restore.spec.mjs collaboration-capability.spec.mjs share-capability.spec.mjs",
    "test:browser:performance": "npm run test:browser:playwright -- performance.spec.mjs --workers=1",
    "bundle:check": "node scripts/check-bundle-chunks.mjs",
    "test:surface-colors": "node scripts/check-surface-colors.mjs",
    "lint:fast": "oxlint tabula-app/src packages/tabula/src scripts --deny-warnings"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.9",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@tanstack/react-virtual": "^3.14.10",
    "@vitejs/plugin-react": "^5.0.0",
    "d3-force": "^3.0.0",
    "dexie": "^4.4.5",
    "fflate": "^0.8.3",
    "firebase": "^12.18.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lib0": "^0.2.117",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^11.17.1",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-deflist": "^1.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-supersub": "^1.0.0",
    "socket.io-client": "^4.8.1",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.0",
    "yjs": "^13.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "oxlint": "^1.80.0",
    "playwright": "^1.60.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
